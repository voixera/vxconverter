# ---------------------------------------------------------------------------
# VX Converter - Engine V4 VX
# ---------------------------------------------------------------------------

# Set this ONLY on the Vercel front-end to proxy /api/* to your Docker/VPS
# backend that has yt-dlp + ffmpeg installed. Leave empty when self-hosting the
# whole app on the VPS (the local API routes are used directly).
# Example: VX_API_BASE=https://api.your-domain.com
VX_API_BASE=

# Binary locations for the engine. Defaults are discovered on PATH, so in the
# provided Dockerfile these are set for you. Override for custom installs.
YTDLP_PATH=
FFMPEG_PATH=

# Test-only: allows the loopback fixture server to be fetched by the SSRF guard.
# NEVER set in production.
# VX_ALLOW_TEST_HOSTS=1

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

DATABASE_URL=postgres://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

VX_SCAN_TTL=300

VX_ANALYZE_LIMIT=10

VX_DOWNLOAD_LIMIT=20

VX_REQUEST_TIMEOUT=15000

VX_MAX_REDIRECTS=5

VX_MAX_RESPONSE_SIZE=15728640

RUST_LOG=info
PORT=8080
